POSTGRES_CONTAINER ?= airbnb-postgres-dev
POSTGRES_IMAGE ?= postgres:16
POSTGRES_PORT ?= 5432
POSTGRES_DB ?= airbnb_dev
POSTGRES_USER ?= postgres
POSTGRES_PASSWORD ?= postgres
POSTGRES_VOLUME ?= airbnb-postgres-data

.PHONY: backend db-up db-down db-logs migration migrate migration-history

## Start the FastAPI development server at http://127.0.0.1:8000.
backend:
	@cd backend && .venv/bin/fastapi dev main.py

## Start (or reuse) the local PostgreSQL development database.
db-up:
	@if docker container inspect $(POSTGRES_CONTAINER) >/dev/null 2>&1; then \
		docker start $(POSTGRES_CONTAINER) >/dev/null 2>&1 || true; \
	else \
		docker run --detach \
			--name $(POSTGRES_CONTAINER) \
			--publish $(POSTGRES_PORT):5432 \
			--env POSTGRES_DB=$(POSTGRES_DB) \
			--env POSTGRES_USER=$(POSTGRES_USER) \
			--env POSTGRES_PASSWORD=$(POSTGRES_PASSWORD) \
			--volume $(POSTGRES_VOLUME):/var/lib/postgresql/data \
			$(POSTGRES_IMAGE) >/dev/null; \
	fi
	@echo "PostgreSQL is available at postgresql://$(POSTGRES_USER):$(POSTGRES_PASSWORD)@localhost:$(POSTGRES_PORT)/$(POSTGRES_DB)"

## Stop the development database without deleting its data.
db-down:
	@docker stop $(POSTGRES_CONTAINER) >/dev/null 2>&1 || true

## Follow PostgreSQL container logs.
db-logs:
	@docker logs --follow $(POSTGRES_CONTAINER)

## Create an autogenerated migration from your SQLAlchemy models.
## Usage: make migration MIGRATION_NAME="create listings table"
migration:
	@test -n "$(MIGRATION_NAME)" || (echo 'Usage: make migration MIGRATION_NAME="describe schema change"' && exit 1)
	@cd backend && .venv/bin/alembic revision --autogenerate --message "$(MIGRATION_NAME)"

## Apply all pending migrations to the configured database.
migrate:
	@cd backend && .venv/bin/alembic upgrade head

## Show the current migration history.
migration-history:
	@cd backend && .venv/bin/alembic history
