# Comma-separated origins allowed to call the API from a browser.
# Replace with the public URL Railway assigns to the frontend service.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-service.up.railway.app

# Set this to the Railway PostgreSQL connection string, adapted for SQLAlchemy:
# postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://user:password@host:port/database
